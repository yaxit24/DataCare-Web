    ' SQL: ' AND  LOGIN_NAME = '
    ' SQL: ' AND LOGIN_NAME <> 'ABC'
    ' SQL: ' AND LOGIN_NAME = '
    ' SQL: ' ORDER BY LOGIN_NAME
    ' SQL: ' WHERE LOGIN_NAME = '
    ' SQL: ) AND LOGIN_NAME <> 'ABC'
    ' SQL: ;Persist Security Info=True;User ID=sa;Password=
    ' SQL: ALTER TABLE USER_SET ADD LC_CODE VARCHAR(2) DEFAULT '00'
    ' SQL: ALTER TABLE USER_SET ALTER COLUMN USER_NAME VARCHAR(15)
    ' SQL: DELETE FROM LOGIN_MAST WHERE CO_CODE  IN (
    ' SQL: DELETE FROM LOGIN_MAST WHERE CO_CODE = '
    ' SQL: DELETE FROM LOGIN_MAST WHERE CO_CODE = '01' AND  LOGIN_NAME = '

End Class
