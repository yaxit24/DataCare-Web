  "mSG[mSG.Row, 9] = Strings.Format((object)(Conversion.Val(mSG[mSG.Row, 6]) * (Conversion.Val(mSG[mSG.Row, 7]) + Conversion.Val(mSG[mSG.Row, 8])) / 100.0), \"0.000\");",
