 "formulas": [
  {
   "name": "AcName",
   "ref": "{@AcName}",
   "type": "StringField",
   "text": "if {TAX_DATA.PARTY_NAME} = '' then {AC_MAST.AC_NAME} else {TAX_DATA.PARTY_NAME}"
  },
  {
   "name": "Address",
   "ref": "{@Address}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1}+' '+{CO_MAST.CO_ADD2}+' '+{CO_MAST.CO_ADD3}+' '+{CO_MAST.CO_CITY}+'-'+{CO_MAST.CO_PIN}"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "DateField",
   "text": "Date(2001,04,01)"
  },
  {
   "name": "GrossVal",
   "ref": "{@GrossVal}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'S' Then if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.NET_AMT}-{TAX_DATA.DISC_AMT} else - ({TAX_DATA.NET_AMT}-{TAX_DATA.DISC_AMT}) else if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_"
  },
  {
   "name": "IGST",
   "ref": "{@IGST}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'S' Then if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT} else if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "IgstRate",
   "ref": "{@IgstRate}",
   "type": "NumberField",
   "text": "{TAX_DATA.TAX_PRC}"
  },
  {
   "name": "PayRec",
   "ref": "{@PayRec}",
   "type": "StringField",
   "text": "if Sum ({@IGST}) > 0 then 'Payble' else 'Refundable'"
  },
  {
   "name": "PurchaseVatAmt",
   "ref": "{@PurchaseVatAmt}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'P' Then if {TAX_DATA.TAX_SIGN} = \"-\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "RptTitel",
   "ref": "{@RptTitel}",
   "type": "StringField",
   "text": "'VatReport'"
  },
  {
   "name": "SaleVatAmt",
   "ref": "{@SaleVatAmt}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'S' Then if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "SectionType",
   "ref": "{@SectionType}",
   "type": "StringField",
   "text": "''"
  },
  {
   "name": "TaxFreeAmt",
   "ref": "{@TaxFreeAmt}",
   "type": "NumberField",
   "text": "{TAX_DATA.TAX_FREE_AMT}"
  },
  {
   "name": "TaxType",
   "ref": "{@TaxType}",
   "type": "StringField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'S' Then 'Output Tax (Sales)' else if {TAX_DATA.TRAN_TYPE} = 'P' Then 'Input Tax (Purchase)' Else ''"
  },
  {
   "name": "ToDate",
   "ref": "{@ToDate}",
   "type": "DateField",
   "text": "Date(2001,07,31)"
  },
  {
   "name": "TotAmt",
   "ref": "{@TotAmt}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TRAN_TYPE} = 'S' Then if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TOT_AMT}+{TAX_DATA.TAX_FREE_AMT} else -({TAX_DATA.TOT_AMT}+{TAX_DATA.TAX_FREE_AMT}) else if {TAX_DATA.TAX_SIGN} = \"+\" the"
  },
  {
   "name": "VchGroup",
   "ref": "{@VchGroup}",
   "type": "StringField",
   "text": "{TAX_DATA.CO_YEAR}+{TAX_DATA.CO_BOOK}+{TAX_DATA.VCH_NO}+totext({TAX_DATA.NET_AMT})"
  },
  {
   "name": "VchNo",
   "ref": "{@VchNo}",
   "type": "StringField",
   "text": "{BOOK_DATA.BOOK_SR_NAME} & \"-\" & {TAX_DATA.VCH_NO}"
  }
