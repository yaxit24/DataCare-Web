   "type": "StringField",
   "text": "'KARIGAR ISSUE REGISTER'"
  },
  {
   "name": "TotalRate",
   "ref": "{@TotalRate}",
   "type": "NumberField",
   "text": "if Sum ({@DiffAmt}) <> 0 and Sum ({@DiffWt}) <> 0 then round(Sum ({@DiffAmt})/Sum ({@DiffWt}))*10"
  }
