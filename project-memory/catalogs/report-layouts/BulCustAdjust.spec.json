   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "DateRate",
   "ref": "{@DateRate}",
   "type": "NumberField",
   "text": "if Sum ({@DiffWt}, {BUL_DATA.VCH_DATE}, \"daily\") <> 0 and Sum ({@DiffAmt}, {BUL_DATA.VCH_DATE}, \"daily\") <> 0 then round(Sum ({@DiffAmt}, {BUL_DATA.VCH_DATE}, \"daily\")/Sum ({@DiffWt}, {BUL_DATA.VCH_DA"
  },
  {
   "name": "DiffAmt",
   "ref": "{@DiffAmt}",
   "type": "NumberField",
   "text": "if {@DiffWt} <> 0 and {BUL_DATA.ITM_RATE} <> 0 then round({@DiffWt} * {BUL_DATA.ITM_RATE}/10)"
  },
  {
   "name": "DiffWt",
   "ref": "{@DiffWt}",
   "type": "NumberField",
   "text": "{BUL_DATA.ITM_GWT}-{BUL_DATA.ADJ_WT}"
