 "formulas": [
  {
   "name": "AcName",
   "ref": "{@AcName}",
   "type": "StringField",
   "text": "if {TAX_DATA.PARTY_NAME} = '' then {AC_MAST.AC_NAME} else {TAX_DATA.PARTY_NAME}"
  },
  {
   "name": "Address",
   "ref": "{@Address}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1}+' '+{CO_MAST.CO_ADD2}+' '+{CO_MAST.CO_ADD3}+' '+{CO_MAST.CO_CITY}+'-'+{CO_MAST.CO_PIN}"
  },
  {
   "name": "AddVat",
   "ref": "{@AddVat}",
   "type": "UnknownField",
   "text": "IF {BOOK_DATA.BOOK_INOUT}='O' THEN {TAX_DATA.ADD_TAX_AMT} ELSE -({TAX_DATA.ADD_TAX_AMT})"
  },
  {
   "name": "BillGroup",
   "ref": "{@BillGroup}",
   "type": "StringField",
   "text": "{TAX_DATA.CO_YEAR}+{TAX_DATA.CO_BOOK}+{TAX_DATA.VCH_NO}"
  },
  {
   "name": "Book",
   "ref": "{@Book}",
   "type": "StringField",
   "text": "{TAX_DATA.CO_BOOK}"
  },
  {
   "name": "CGST",
   "ref": "{@CGST}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'S' THEN if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "CgstRate",
   "ref": "{@CgstRate}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'S' THEN {TAX_DATA.TAX_PRC}"
  },
  {
   "name": "CurMonth",
   "ref": "{@CurMonth}",
   "type": "StringField",
   "text": "RIGHT({@RptTitel},10)"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "DateField",
   "text": "Date(2001,04,01)"
  },
  {
   "name": "GrossVal",
   "ref": "{@GrossVal}",
   "type": "NumberField",
   "text": "if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.NET_AMT}-{TAX_DATA.DISC_AMT} else - ({TAX_DATA.NET_AMT}-{TAX_DATA.DISC_AMT})"
  },
  {
   "name": "IGST",
   "ref": "{@IGST}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'I' THEN if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "IgstRate",
   "ref": "{@IgstRate}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'I' THEN {TAX_DATA.TAX_PRC}"
  },
  {
   "name": "ItemAmt",
   "ref": "{@ItemAmt}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'I' THEN if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.NET_AMT} else -{TAX_DATA.NET_AMT}"
  },
  {
   "name": "MonthTot",
   "ref": "{@MonthTot}",
   "type": "StringField",
   "text": "'N'"
  },
  {
   "name": "RptTitel",
   "ref": "{@RptTitel}",
   "type": "StringField",
   "text": "'VatReport'"
  },
  {
   "name": "SectionType",
   "ref": "{@SectionType}",
   "type": "StringField",
   "text": "''"
  },
  {
   "name": "ServiceAmt",
   "ref": "{@ServiceAmt}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'S' THEN if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.NET_AMT} else -{TAX_DATA.NET_AMT}"
  },
  {
   "name": "SGST",
   "ref": "{@SGST}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'SGST' THEN if {TAX_DATA.TAX_SIGN} = \"+\" then {TAX_DATA.TAX_AMT} else -{TAX_DATA.TAX_AMT}"
  },
  {
   "name": "SGSTFDF",
   "ref": "{@SGSTFDF}",
   "type": "NumberField",
   "text": "IF {TAX_DATA.TAX_TYPE} = 'SGST' THEN {TAX_DATA.TAX_AMT}"
  },
  {
   "name": "SgstRate",
   "ref": "{@SgstRate}",
   "type": "NumberField",
   "text": "IF {@CGST}+{@SGST} <> 0 THEN {TAX_DATA.TAX_PRC}"
  },
  {
   "name": "TaxGroup",
   "ref": "{@TaxGroup}",
   "type": "StringField",
   "text": "IF {BOOK_DATA.BOOK_INOUT}='O' THEN \"1\"+{TAX_DATA.CO_BOOK} else \"2\"+{TAX_DATA.CO_BOOK}"
  },
  {
