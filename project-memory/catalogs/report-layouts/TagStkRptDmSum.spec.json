  {
   "name": "CoAdd",
   "ref": "{@CoAdd}",
   "type": "StringField",
   "text": "IF {CO_MAST.REP_ADD_TYPE} = 'L' THEN {LOCT_MAST.LC_ADD1} + ', ' + {LOCT_MAST.LC_ADD2} + ', ' + {LOCT_MAST.LC_ADD3} + ', ' + {LOCT_MAST.LC_CITY} ELSE {CO_MAST.CO_ADD1} + ', ' + {CO_MAST.CO_ADD2} + ', '"
