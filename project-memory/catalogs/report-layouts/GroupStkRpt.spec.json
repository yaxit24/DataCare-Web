 "formulas": [
  {
   "name": "ClNet",
   "ref": "{@ClNet}",
   "type": "NumberField",
   "text": "if {MAIN_STOCK.VCH_DATE} <= {@ToDate} then if {MAIN_STOCK.ITM_SIGN} = '+' then {@ItmWt} else - {@ItmWt}"
  },
  {
   "name": "ClQty",
   "ref": "{@ClQty}",
   "type": "NumberField",
