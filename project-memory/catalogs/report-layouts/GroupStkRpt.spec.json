  },
  {
   "name": "InNet",
   "ref": "{@InNet}",
   "type": "NumberField",
   "text": "if {MAIN_STOCK.VCH_DATE} >= {@FromDate} and {MAIN_STOCK.VCH_DATE} <= {@ToDate} then if {MAIN_STOCK.ITM_SIGN} = '+' then {@ItmWt} else 0"
  },
  {
