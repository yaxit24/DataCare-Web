  },
  {
   "name": "OpNet",
   "ref": "{@OpNet}",
   "type": "NumberField",
   "text": "if {MAIN_STOCK.VCH_DATE} < {@FromDate} then if {MAIN_STOCK.ITM_SIGN} = '+' then {@ItmWt} else - {@ItmWt}"
  },
  {
   "name": "OpPcs",
   "ref": "{@OpPcs}",
   "type": "NumberField",
   "text": "if {MAIN_STOCK.VCH_DATE} < {@FromDate} then if {MAIN_STOCK.ITM_SIGN} = '+' then {@Itmqty} else - {@Itmqty}"
  },
  {
   "name": "OutNet",
