  },
  {
   "name": "ClAcCrDr",
   "ref": "{@ClAcCrDr}",
   "type": "StringField",
   "text": "if Sum ({@Closing}, {AC_DATA.AC_CODE}) > 0 then 'Cr' else if Sum ({@Closing}, {AC_DATA.AC_CODE}) < 0 then 'Dr'"
  },
  {
   "name": "ClGrpCrdr",
   "ref": "{@ClGrpCrdr}",
   "type": "StringField",
   "text": "if Sum ({@Closing}, {AC_MAST.AC_GR}) > 0 then 'Cr' else if Sum ({@Closing}, {AC_MAST.AC_GR}) < 0 then 'Dr'"
  },
  {
   "name": "Closing",
   "ref": "{@Closing}",
   "type": "NumberField",
   "text": "{@OpenAmt}+{@CurCrAmt}-{@CurDrAmt}"
  },
  {
   "name": "ClTotCrDr",
   "ref": "{@ClTotCrDr}",
   "type": "StringField",
   "text": "if Sum ({@Closing}) > 0 then 'Cr' else if Sum ({@Closing}) < 0 then 'Dr'"
  },
  {
   "name": "co_add1",
   "ref": "{@co_add1}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1}+\" \"+{CO_MAST.CO_ADD2} +\" \"+{CO_MAST.CO_ADD3}+\" \"+ {CO_MAST.CO_CITY}+' '+{CO_MAST.CO_PIN}+' '+'Phone : ' +{CO_MAST.CO_PHONE}"
  },
  {
   "name": "co_name",
   "ref": "{@co_name}",
   "type": "StringField",
   "text": "{CO_MAST.CO_NAME}"
  },
  {
   "name": "CurCrAmt",
   "ref": "{@CurCrAmt}",
   "type": "NumberField",
   "text": "if {AC_DATA.VCH_DATE} >={@FromDate} then IF {AC_DATA.CR_AMT} <> 0 THEN {AC_DATA.CR_AMT}"
  },
  {
   "name": "CurDrAmt",
   "ref": "{@CurDrAmt}",
   "type": "NumberField",
   "text": "if {AC_DATA.VCH_DATE} >={@FromDate} then IF {AC_DATA.DR_AMT} <> 0 THEN {AC_DATA.DR_AMT}"
  },
  {
   "name": "CurPag",
   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "DateField",
   "text": "Date(2002,12,01)"
  },
  {
   "name": "OpAcCrdr",
   "ref": "{@OpAcCrdr}",
   "type": "StringField",
   "text": "if Sum ({@OpenAmt}, {AC_DATA.AC_CODE}) > 0 then 'Cr' else if Sum ({@OpenAmt}, {AC_DATA.AC_CODE}) < 0 then 'Dr'"
  },
  {
   "name": "OpenAmt",
   "ref": "{@OpenAmt}",
   "type": "NumberField",
   "text": "if {AC_DATA.VCH_DATE} < {@FromDate} then {AC_DATA.CR_AMT}-{AC_DATA.DR_AMT}"
  },
  {
   "name": "OpGrpCrDr",
   "ref": "{@OpGrpCrDr}",
   "type": "StringField",
   "text": "if Sum ({@OpenAmt}, {AC_MAST.AC_GR}) > 0 then 'Cr' else if Sum ({@OpenAmt}, {AC_MAST.AC_GR}) < 0 then 'Dr'"
  },
  {
   "name": "OpTotCrDr",
   "ref": "{@OpTotCrDr}",
