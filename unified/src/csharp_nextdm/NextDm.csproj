<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>DataCareNext</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>False</Optimize>
    <NoWarn>CS0219;CS0168;CS0649;CS1998;CS8019</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DataCareNext.exe.licenses" />
    <EmbeddedResource Include="DataCareNext.exe.licenses" LogicalName="DataCareNext.exe.licenses" />
  </ItemGroup>

  <ItemGroup>
