# Provider keys for worker sessions. Copy to <root>/state/providers.env (bootstrap does this) and fill in the
# ones you have. That file is outside the repository: never commit keys, never paste them into a document, a
# packet or a chat. Lines are NAME=value. Leave a line empty or commented when you do not use that provider.
#
# The catalog that explains each provider is orchestration/config/providers.json.

# DeepSeek API (pay as you go)
# DEEPSEEK_API_KEY=

# OpenRouter (one key, many models)
# OPENROUTER_API_KEY=

# Any Anthropic-compatible endpoint, used by the claude worker tool for cheap models.
# The dispatcher maps these onto ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN inside the worker process only.
# DC_ANTHROPIC_BASE_URL=
# DC_ANTHROPIC_AUTH_TOKEN=

# Codex CLI with an API key instead of a ChatGPT sign-in
# CODEX_API_KEY=

# Alibaba Cloud Coding Plan: interactive use only, never through the dispatcher (see providers.json)
# DASHSCOPE_CODING_API_KEY=
