  "databaseSchedules": [
    {
      "id": "D01",
      "schedule": "No-op admitted callback; SERIALIZABLE, fixed Return update; all scoped raw/xmin/ctid unchanged",
      "expected": "success; one callback; no auth writes"
    },
    {
      "id": "D02",
      "schedule": "Command SHARE first; callback marker write; selection UPDATE waits until commit",
      "expected": "command marker committed then selection epoch8; no command auth write"
    },
    {
      "id": "D03",
      "schedule": "Selection UPDATE uncommitted before command snapshot; command SHARE waits; selection commits",
      "expected": "command409 known serialization before callback; selection remains8; no marker change"
    },
    {
      "id": "D04",
      "schedule": "Actor holds session UPDATE lock without changing tuple; expiry passes during command wait",
      "expected": "401 session-expired after lock; no callback; exact raw unchanged"
    },
    {
      "id": "D05",
      "schedule": "Actor updates marker after command first read; command rereads same row in same snapshot",
      "expected": "both reads before; actor change committed; no latest-at-response claim"
    },
    {
      "id": "D06",
      "schedule": "Command SHARE held; actual refresh waits",
      "expected": "command succeeds then actual refresh rotates JTI; command did not rotate"
    },
    {
      "id": "D07",
      "schedule": "Command SHARE held; actual logout waits",
      "expected": "command succeeds then revoked logout"
    },
    {
      "id": "D08",
      "schedule": "Command SHARE held; reset holds LOGIN then waits session",
      "expected": "command completes without later LOGIN lock; actual reset succeeds"
    },
    {
      "id": "D09",
      "schedule": "Callback writes marker then natural expiry before final SQL",
      "expected": "401 final expiry; marker and all raw/xmin/ctid rollback"
    },
    {
      "id": "D10",
      "schedule": "selected company02; immutable login company01",
      "expected": "admitted selected principal company02; session unchanged"
    },
    {
      "id": "D11",
      "schedule": "Committed FRM_EDIT=N before snapshot while FRM_VIEW=Y",
      "expected": "403 update denied before callback; unchanged raw"
    },
    {
      "id": "D12",
      "schedule": "USER_SET edit revocation commits after snapshot",
      "expected": "first snapshot retains EditY; subsequent command403; no universal current-rights guarantee"
    },
    {
      "id": "D13",
      "schedule": "Callback marker DML then explicit throw",
      "expected": "original error; exact full rollback"
    },
    {
      "id": "D14",
      "schedule": "Prohibited callback mutates same session epoch then returns",
      "expected": "409 context-stale; session and marker rollback"
    },
    {
      "id": "D15",
      "schedule": "Two Serializable commands share session; both read PARTY+PEER then independently update one different marker",
      "expected": "exactly one success and one409 SSI; each callback once; one marker changes; auth unchanged"
    },
    {
      "id": "D16",
      "schedule": "Callback reads PARTY, independent actor commits PARTY update, callback attempts same row update",
      "expected": "409 serialization; actor value preserved; no retry; auth/foreign rows unchanged"
    },
    {
      "id": "D17",
      "schedule": "Prohibited callback changes only unknown ledger reason plus marker",
      "expected": "409 context-stale; entire candidate transaction rollback"
    }
  ]
