{
  "version": 1,
  "kind": "batch1-tx-extraction-current-behavior-independent",
  "authoredBeforeStagedImplementationInspection": true,
  "sourceOfExpectedDecisions": "Current original web businessScope.ts/authorization.ts/rightsOf/isAdminRole; this is an extraction regression contract, not new desktop parity or auth-session integration evidence.",
  "queryRowsMeaning": "Literal results are in the order produced by the existing SQL. A fake query queue must not emulate SQL sorting/membership. Separately compare SQL semantics and bindings to the original source.",
  "undefinedEncoding": "expected.ownUndefinedKeys names own output properties whose values must be undefined; omitted JSON keys are not evidence that the JS result omits these properties.",
