  "transactionInvariants": [
    {
      "id": "TX01",
      "expected": "Each public login/selected/principal wrapper opens exactly one withTenant callback with input.tenantId; all its domain queries use that callback tx."
    },
    {
      "id": "TX02",
      "expected": "Direct Tx helpers open zero transactions and do not call set_config, $transaction, withTenant or set isolation; caller must already bind tenant and choose transaction isolation."
    },
    {
      "id": "TX03",
      "expected": "An original query rejection propagates as the same error without reclassification, swallowing, fallback query or partial successful return."
    },
    {
      "id": "TX04",
      "expected": "Company refusal stops before location/year; location refusal stops before year; principal absence remains PrincipalUnavailableError."
    },
    {
      "id": "TX05",
      "expected": "No new row-lock clause, writes, LOGIN/USER_SET semantics, input coercion, last-day-lock invocation, token/session/epoch/ledger integration is added."
    },
    {
      "id": "TX06",
      "expected": "One default withTenant transaction is not a RepeatableRead guarantee and is not atomic with later separate auth/session/last-lock calls."
    }
  ]
}
