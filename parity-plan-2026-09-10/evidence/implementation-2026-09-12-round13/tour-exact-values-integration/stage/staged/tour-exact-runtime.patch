+/** Saved input-shaped scalars only; no raw tables, calculated fields or client authority are copied. */
+function preserveSavedTourValues(
+  payload: Record<string, unknown>,
+  f: ReturnType<typeof blankOrderHeader>,
+  header: Record<string, string>,
+  rows: Row[],
+  expectedVersion: string | undefined,
+  original: Record<string, any>,
+): Record<string, unknown> {
+  if (typeof original.version !== 'string' || expectedVersion !== original.version)
+    throw new Error('The saved Tour Order snapshot no longer matches this edit; reload it.');
+  const scalar = (value: unknown): value is string | number | null =>
+    value === null || typeof value === 'string' || typeof value === 'number';
+  const copyCell = (
+    out: Record<string, unknown>,
+    field: string,
+    visible: unknown,
+    prior: Record<string, any> | undefined,
+    numeric: boolean,
+  ) => {
+    const editor = String(visible ?? '');
+    if (
+      prior &&
+      Object.hasOwn(prior, field) &&
+      scalar(prior[field]) &&
+      editor === String(prior[field] ?? '')
+    ) {
+      out[field] = prior[field];
+      return;
+    }
+    // The existing calculation, not Number coercion in the browser, must decide whether this
+    // changed saved decimal is supported. Blank/nondecimal syntax retains existing parser behavior.
+    const text = editor.trim();
+    const decimal = /^[+-]?\d+(?:\.\d+)?$/.exec(text);
+    if (numeric && decimal?.[0] === text) out[field] = text;
+  };
+  for (const field of Object.keys(f) as Array<keyof typeof f>)
+    copyCell(payload, field, f[field], original, ['taxRatePct', 'advanceAmount'].includes(field));
+  for (const [field] of extendedHeaderFields)
+    copyCell(payload, field, header[field], original, numericHeaderFields.has(field));
+  const kept = rows.filter((row) => row.itCode.trim());
+  for (const [index, out] of (payload.lines as Record<string, any>[]).entries()) {
+    const row = kept[index]!;
+    const matches = row.srNo
+      ? (original.lines ?? []).filter(
+          (line: Record<string, unknown>) => String(line.srNo) === row.srNo,
+        )
+      : [];
+    if (matches.length > 1)
+      throw new Error('The saved Tour Order item identity is ambiguous; reload it.');
+    const prior = matches[0] as Record<string, any> | undefined;
+    for (const field of Object.keys(blank()) as Array<keyof Row>) {
+      if (
