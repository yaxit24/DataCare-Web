{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "env": ["API_ORIGIN"], "outputs": ["dist/**", ".next/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "MIGRATE_DATABASE_URL",
        "RUN_DB_INTEGRITY_TESTS",
        "RUN_DB_SECURITY_TESTS",
        "PARITY_TEST_PORT",
        "PARITY_TEST_DATABASE",
        "PARITY_TEST_SYSTEM_IDENTIFIER"
      ],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "dev": { "cache": false, "persistent": true }
  }
}
