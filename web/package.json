{
  "name": "datacare-web-saas",
  "private": true,
  "version": "0.0.0",
  "description": "DataCareNext jewelry/gold ERP — web SaaS rebuild (Next.js + NestJS + PostgreSQL).",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:browser": "pnpm --filter @datacare/web test:browser",
    "test:parity:api": "node scripts/parity-test-env.mjs -- pnpm --filter @datacare/api test",
    "test:parity:browser": "node scripts/parity-test-env.mjs -- node apps/web/test/parity.real-stack.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/lint-workspace.mjs && eslint . && turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "restore-drill": "pnpm --filter @datacare/db build && pnpm --filter @datacare/api build && node scripts/restore-drill.mjs",
    "load:profile": "pnpm --filter @datacare/db build && pnpm --filter @datacare/api build && node scripts/load-profile.mjs",
    "dev": "turbo run dev",
    "report-baselines": "node scripts/report-baselines.mjs",
    "settings:parity": "node scripts/check-settings-parity.mjs",
    "schema:readiness": "node scripts/check-schema-readiness.mjs",
    "g5:parity": "node scripts/check-g5-parity.mjs",
    "fresh:provision": "node scripts/check-fresh-provision.mjs",
    "type:parity": "node scripts/check-type-parity.mjs",
    "register:check": "node scripts/check-completion-register.mjs",
    "release:certify": "node scripts/release-certify.mjs",
    "docs:refs": "node scripts/check-doc-references.mjs",
    "typecheck:tests": "cd apps/api && NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.test.json --noEmit && cd ../.. && pnpm --filter @datacare/core typecheck:tests",
    "lint:eslint": "eslint .",
    "parity:measure": "node scripts/parity-measure.mjs",
    "depth:parity": "node scripts/check-depth.mjs",
    "depth:audit": "node scripts/check-depth.mjs --audit",
    "test:routes": "pnpm --filter @datacare/web test:routes",
    "depth:deadcells": "node scripts/check-dead-cells.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.0",
    "turbo": "2.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "mssql": "12.6.0",
    "tedious": "19.2.1"
  }
}
