  "qualifications": [
    {
      "ids": [
        "R05"
      ],
      "text": "Principal fallback alone does not authorize a stored company. Missing LOGIN_MAST02 ordinary user is refused by exact scope membership; historical current refresh allowed fallback without this validation."
    },
    {
      "ids": [
        "R20",
        "L08"
      ],
      "text": "The injected commit-failure denotes a confirmed database abort. An ambiguous lost COMMIT response may leave committed rotation/new session without published cookies; no automatic safe retry is proved."
    },
    {
      "ids": [
        "C02",
        "C03"
      ],
      "text": "Synthetic receipt hash models a separately committed session-row transition. It does not prove invocation of selectSessionContext; actual selection tests need a real request fingerprint."
    },
    {
      "ids": [
        "C09"
      ],
      "text": "The retained-session literal alone cannot prove other-session revocation. Real lifecycle tests must seed and assert a noncurrent session sentinel."
    },
    {
      "ids": [
        "R11",
        "Q03"
      ],
      "text": "Expired after lock commits existing expiry revocation. Crossing expiry only during signing aborts the rotation transaction with original hash/last_used/revocation fields unchanged."
    },
    {
      "ids": [],
      "text": "Production expiry authority is exact database timestamptz comparison against clock_timestamp after lock and again in final guarded update. Tests may inject trusted clocks only. The new Q03 microsecond boundary must use exact SQL clock values or a real database schedule, never JavaScript Date rounding."
    },
    {
      "ids": [],
      "text": "Missing refresh cookie currently returns early401 without clearing access. Generic clear-both-cookie statements apply caught failures with a presented refresh token, not every401 path."
    }
