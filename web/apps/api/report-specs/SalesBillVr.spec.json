 "formulas": [
  {
   "name": "AcAdd1",
   "ref": "{@AcAdd1}",
   "type": "StringField",
   "text": "if {SL_DATA.ADD1} <> '' then {SL_DATA.ADD1} + ' , ' + {SL_DATA.ADD2} else {AC_MAST.AC_ADD1} + ' , ' + {AC_MAST.AC_ADD2}"
  },
  {
   "name": "AcAdd2",
   "ref": "{@AcAdd2}",
   "type": "StringField",
   "text": "if{SL_DATA.ADD1} <> '' then {SL_DATA.ADD3} + ' , ' + {SL_DATA.CITY} else {AC_MAST.AC_ADD3} + ' , ' + {AC_MAST.AC_CITY}"
  },
  {
   "name": "AcGstNo",
   "ref": "{@AcGstNo}",
   "type": "UnknownField",
   "text": "'Gst No : ' + {AC_MAST.AC_LSTNO}"
  },
  {
   "name": "AcMobile",
   "ref": "{@AcMobile}",
   "type": "StringField",
   "text": "if{SL_DATA.ADD1} <> '' then 'Mo : ' + {SL_DATA.MOBILE} else if {AC_MAST.AC_MOBILE} <> '' then 'Mo : ' + {AC_MAST.AC_MOBILE} else if {AC_MAST.AC_PHONE} <> '' then 'Ph : ' + {AC_MAST.AC_MOBILE} else 'Mo"
  },
  {
   "name": "CashAmt",
   "ref": "{@CashAmt}",
   "type": "NumberField",
   "text": "if {SL_DATA.AC_CODE} = '00045' then {SL_DATA.TOT_AMT} - {SL_DATA.ADV_AMT} -{SL_DATA.OLD_GL_AMT} -{SL_DATA.OLD_SL_AMT}-{SL_DATA.KASAR_AMT} else {SL_DATA.CASH_AMT}"
  },
  {
   "name": "ClAmt",
   "ref": "{@ClAmt}",
   "type": "NumberField",
   "text": "0"
  },
  {
   "name": "ClAmtCrDr",
   "ref": "{@ClAmtCrDr}",
   "type": "StringField",
   "text": "if {@ClAmt} > 0 then 'Cr' else 'Dr'"
  },
  {
   "name": "CoAdd2",
   "ref": "{@CoAdd2}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD2} + ' , ' + {CO_MAST.CO_ADD3}"
  },
  {
   "name": "CoCity",
   "ref": "{@CoCity}",
   "type": "StringField",
