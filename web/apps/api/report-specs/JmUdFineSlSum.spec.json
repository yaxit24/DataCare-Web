 "formulas": [
  {
   "name": "AcName",
   "ref": "{@AcName}",
   "type": "StringField",
   "text": "if {AC_MAST.AC_CITY} <>\"\" then {AC_MAST.AC_NAME} & \" ,\" &{AC_MAST.AC_CITY} else {AC_MAST.AC_NAME}"
  },
  {
   "name": "AmtCrTot",
   "ref": "{@AmtCrTot}",
   "type": "NumberField",
   "text": "if {@OpAmtBal} > 0 then Sum ({@CrAmt}, {@PartyAcGroup}) +{@OpAmtBal} else Sum ({@CrAmt}, {@PartyAcGroup})"
  },
  {
   "name": "AmtDrTot",
   "ref": "{@AmtDrTot}",
   "type": "NumberField",
   "text": "if {@OpAmtBal} < 0 then Sum ({@DrAmt}, {@PartyAcGroup}) - {@OpAmtBal} else Sum ({@DrAmt}, {@PartyAcGroup})"
  },
  {
   "name": "BalAmtCrDr",
   "ref": "{@BalAmtCrDr}",
   "type": "StringField",
   "text": "if {@ClAmtBal} > 0 then 'Jama' else 'Udhar';"
  },
  {
   "name": "BalCrDr",
   "ref": "{@BalCrDr}",
   "type": "StringField",
   "text": "if {@ClBal} > 0 then 'Jama' else 'Udhar';"
  },
  {
   "name": "ClAmtBal",
   "ref": "{@ClAmtBal}",
   "type": "NumberField",
   "text": "0"
  },
  {
   "name": "ClBal",
   "ref": "{@ClBal}",
   "type": "NumberField",
   "text": "0"
  },
  {
   "name": "Co_Add1",
   "ref": "{@Co_Add1}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1}+' '+{CO_MAST.CO_ADD2}+' '+{CO_MAST.CO_ADD3} + {CO_MAST.CO_CITY}+' '+{CO_MAST.CO_PIN}"
  },
  {
   "name": "co_name",
   "ref": "{@co_name}",
   "type": "StringField",
   "text": "{CO_MAST.CO_NAME}"
  },
  {
   "name": "CrAmt",
   "ref": "{@CrAmt}",
   "type": "NumberField",
   "text": "{FINE_DATA.CR_AMT}"
  },
  {
   "name": "CrFine",
   "ref": "{@CrFine}",
   "type": "NumberField",
   "text": "if {FINE_DATA.ITM_SIGN} = '+' THEN {FINE_DATA.ITM_FINE}"
  },
  {
   "name": "CrOthAmt",
   "ref": "{@CrOthAmt}",
   "type": "NumberField",
   "text": "if {FINE_DATA.ITM_SIGN} = '+' then {FINE_DATA.LBR_AMT} + {FINE_DATA.OTH_AMT} ELSE 0"
  },
  {
   "name": "CurPag",
   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "CutRate",
   "ref": "{@CutRate}",
   "type": "NumberField",
   "text": "if {FINE_DATA.AC_NAME} = 'RATE CUT' then {FINE_DATA.ITM_RATE}"
  },
  {
   "name": "DataType",
   "ref": "{@DataType}",
   "type": "StringField",
   "text": "'C'"
  },
  {
   "name": "DrAmt",
   "ref": "{@DrAmt}",
   "type": "NumberField",
   "text": "{FINE_DATA.DR_AMT}"
  },
  {
   "name": "DrFine",
   "ref": "{@DrFine}",
   "type": "NumberField",
   "text": "if {FINE_DATA.ITM_SIGN} = '-' AND {FINE_DATA.CO_BOOK} <> '032' THEN {FINE_DATA.ITM_FINE}"
  },
  {
   "name": "FilneCrTot",
   "ref": "{@FilneCrTot}",
   "type": "NumberField",
   "text": "if {@OpBal} > 0 then {@OpBal}+Sum ({@CrFine}, {@PartyAcGroup}) else Sum ({@CrFine}, {@PartyAcGroup})"
  },
  {
   "name": "FineDrTot",
   "ref": "{@FineDrTot}",
   "type": "NumberField",
   "text": "if {@OpBal} < 0 then Sum ({@DrFine}, {@PartyAcGroup}) - {@OpBal} else Sum ({@DrFine}, {@PartyAcGroup})"
  },
