   "text": "IF Sum ({@OpDrGwt}, {MAIN_STOCK.IT_CODE}) < Sum ({@OpCrGwt}, {MAIN_STOCK.IT_CODE}) THEN Sum ({@OpCrGwt}, {MAIN_STOCK.IT_CODE}) - Sum ({@OpDrGwt}, {MAIN_STOCK.IT_CODE}) ELSE 0"
  },
