  },
  {
   "name": "ItOpCr",
   "ref": "{@ItOpCr}",
   "type": "NumberField",
   "text": "IF Sum ({@OpDrItm}, {MAIN_STOCK.IT_CODE}) < Sum ({@OpCrItm}, {MAIN_STOCK.IT_CODE}) THEN Sum ({@OpCrItm}, {MAIN_STOCK.IT_CODE}) - Sum ({@OpDrItm}, {MAIN_STOCK.IT_CODE}) ELSE 0"
  },
  {
   "name": "ItOpDr",
   "ref": "{@ItOpDr}",
   "type": "NumberField",
   "text": "IF Sum ({@OpDrItm}, {MAIN_STOCK.IT_CODE}) > Sum ({@OpCrItm}, {MAIN_STOCK.IT_CODE}) THEN Sum ({@OpDrItm}, {MAIN_STOCK.IT_CODE})-Sum ({@OpCrItm}, {MAIN_STOCK.IT_CODE}) ELSE 0"
  },
  {
