   "ref": "{@IsuGrWt}",
   "type": "NumberField",
   "text": "if {MAIN_STOCK.VCH_DATE} >= {@FromDate} then if {MAIN_STOCK.ITM_SIGN} ='-' then {MAIN_STOCK.ITM_GWT}"
  },
  {
   "name": "ItemClosing",
   "ref": "{@ItemClosing}",
   "type": "NumberField",
   "text": "({@ItOpCr}+Sum ({@CrRs}, {MAIN_STOCK.IT_CODE}))-({@ItOpDr}+Sum ({@DrRs}, {MAIN_STOCK.IT_CODE}))"
  },
  {
