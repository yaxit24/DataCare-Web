 "formulas": [
  {
   "name": "AcAdd1",
   "ref": "{@AcAdd1}",
   "type": "StringField",
   "text": "{AC_MAST.AC_ADD1} + ' ' + {AC_MAST.AC_ADD2}"
  },
  {
   "name": "AcAdd2",
   "ref": "{@AcAdd2}",
   "type": "StringField",
   "text": "IF {AC_MAST.AC_ADD3} <> '' THEN {AC_MAST.AC_ADD3} + ' ' + {AC_MAST.AC_CITY} ELSE {AC_MAST.AC_CITY}"
  },
  {
   "name": "AcMobile",
   "ref": "{@AcMobile}",
   "type": "StringField",
   "text": "if {AC_MAST.AC_MOBILE} <> '' then 'Mo : ' + {AC_MAST.AC_MOBILE} else if {AC_MAST.AC_PHONE} <> '' then 'Ph : ' + {AC_MAST.AC_MOBILE} else 'Mo : ' + {AC_MAST.AC_MOBILE2}"
  },
  {
   "name": "CoAdd2",
   "ref": "{@CoAdd2}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1} + ' ' + {CO_MAST.CO_ADD2} + ' ' + {CO_MAST.CO_CITY}"
  },
  {
   "name": "CurPag",
   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "DhrnAmt",
   "ref": "{@DhrnAmt}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} >={@FromDate} and {BOOK_DATA.MAIN_BOOK} = 'DHIRAN ISSUE' then {DHRN_DATA.DHRN_AMT} else 0"
  },
  {
   "name": "DhrnIntAmt",
   "ref": "{@DhrnIntAmt}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} >= {@FromDate}then {DHRN_DATA.INT_AMT} else 0"
  },
  {
   "name": "DhrnIntRec",
   "ref": "{@DhrnIntRec}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} >={@FromDate} then -{DHRN_DATA.INT_REC_AMT} else 0"
  },
  {
   "name": "DhrnRec",
   "ref": "{@DhrnRec}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} >={@FromDate} then -({DHRN_DATA.DHRN_REC_AMT}+{DHRN_DATA.UNCHAK_DHRN_REC}) else 0"
  },
  {
   "name": "DhrnRecTot",
   "ref": "{@DhrnRecTot}",
   "type": "NumberField",
   "text": "Sum ({@DhrnRec}, {@VchGroup})+Sum ({@DhrnIntRec}, {@VchGroup})"
  },
  {
   "name": "DhrnTot",
   "ref": "{@DhrnTot}",
   "type": "NumberField",
   "text": "Sum ({@DhrnAmt}, {@VchGroup})+Sum ({@DhrnIntAmt}, {@VchGroup})"
  },
  {
   "name": "for",
   "ref": "{@for}",
   "type": "StringField",
   "text": "'For : ' + {CO_MAST.CO_NAME}"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "DateField",
   "text": "Date(2011,04,01)"
  },
  {
   "name": "OpDhiran",
   "ref": "{@OpDhiran}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} <{@FromDate} and {BOOK_DATA.MAIN_BOOK} = 'DHIRAN ISSUE' then {DHRN_DATA.DHRN_AMT} else if {DHRN_DATA.VCH_DATE} <{@FromDate} then -{DHRN_DATA.DHRN_REC_AMT} else 0"
  },
  {
   "name": "OpInt",
   "ref": "{@OpInt}",
   "type": "NumberField",
   "text": "if {DHRN_DATA.VCH_DATE} <{@FromDate} then {DHRN_DATA.INT_AMT}-{DHRN_DATA.INT_REC_AMT} else 0"
  },
  {
   "name": "OpTotal",
   "ref": "{@OpTotal}",
   "type": "NumberField",
   "text": "Sum ({@OpDhiran}, {@VchGroup}) +Sum ({@OpInt}, {@VchGroup})"
  },
  {
   "name": "Phone",
   "ref": "{@Phone}",
   "type": "StringField",
   "text": "If {CO_MAST.CO_PHONE} <> '' then 'Ph : ' & {CO_MAST.CO_PHONE} + ' Mo : '+ {CO_MAST.CO_MOBILE} else 'Mo : '+ {CO_MAST.CO_MOBILE}"
  },
  {
   "name": "ToDate",
   "ref": "{@ToDate}",
   "type": "DateField",
   "text": "Date(2011,04,01)"
  },
  {
   "name": "TotDhrn",
   "ref": "{@TotDhrn}",
   "type": "NumberField",
   "text": "IF {BOOK_DATA.MAIN_BOOK} = 'DHIRAN ISSUE' THEN {DHRN_DATA.DHRN_AMT} ELSE -({DHRN_DATA.DHRN_REC_AMT}+{DHRN_DATA.UNCHAK_DHRN_REC})"
  },
  {
   "name": "TotDhrnInt",
   "ref": "{@TotDhrnInt}",
   "type": "NumberField",
   "text": "{DHRN_DATA.INT_AMT}-{DHRN_DATA.INT_REC_AMT}"
  },
  {
   "name": "TotPanDhrn",
   "ref": "{@TotPanDhrn}",
   "type": "NumberField",
   "text": "Sum ({@TotDhrn}, {@VchGroup})+Sum ({@TotDhrnInt}, {@VchGroup})"
  },
  {
   "name": "VchGroup",
   "ref": "{@VchGroup}",
   "type": "StringField",
   "text": "{DHRN_DATA.AC_CODE}"
  },
  {
   "name": "WordRuppes",
   "ref": "{@WordRuppes}",
   "type": "StringField",
   "text": "if {DHRN_DATA.DHRN_AMT} <> 0 then 'Ruppes : ' & ucase(ToWords (Sum ({DHRN_DATA.DHRN_AMT}, {@VchGroup}),0 )) & 'ONLY'"
  }
 ],
