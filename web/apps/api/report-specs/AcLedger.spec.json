 "formulas": [
  {
   "name": "AcAmt",
   "ref": "{@AcAmt}",
   "type": "NumberField",
   "text": ""
  },
  {
   "name": "AcBalance",
   "ref": "{@AcBalance}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar AcBal; AcBal := AcBal + {@CrRs} - {@DrRs}; AcBal;"
  },
  {
   "name": "AcName",
   "ref": "{@AcName}",
   "type": "StringField",
   "text": "{AC_MAST.AC_NAME}"
  },
  {
   "name": "AcOpAmt",
   "ref": "{@AcOpAmt}",
   "type": "NumberField",
   "text": "0"
  },
  {
   "name": "AcOpBal",
   "ref": "{@AcOpBal}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar AcBal := {@AcOpAmt} ;"
  },
  {
   "name": "AcOpGold",
   "ref": "{@AcOpGold}",
   "type": "NumberField",
   "text": "0"
  },
  {
   "name": "AcWt",
   "ref": "{@AcWt}",
   "type": "NumberField",
   "text": ""
  },
  {
   "name": "BalDiff",
   "ref": "{@BalDiff}",
   "type": "NumberField",
   "text": "{@CrTotAmt}-{@DrTotAmt}"
  },
  {
   "name": "CoAdd1",
   "ref": "{@CoAdd1}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1} + ' '+{CO_MAST.CO_ADD2} + ' ' + {CO_MAST.CO_CITY}"
  },
  {
   "name": "Company",
   "ref": "{@Company}",
   "type": "StringField",
   "text": "{CO_MAST.CO_NAME}"
  },
  {
   "name": "CrGold",
   "ref": "{@CrGold}",
   "type": "NumberField",
   "text": "if {AC_DATA.IT_TYPE} = 'G' AND {AC_DATA.SIGN} = '+' THEN {AC_DATA.FINE_WT} else 0"
  },
  {
   "name": "CrRs",
   "ref": "{@CrRs}",
   "type": "NumberField",
   "text": "{AC_DATA.CR_AMT}"
  },
  {
   "name": "CrSl",
   "ref": "{@CrSl}",
   "type": "NumberField",
   "text": "if {AC_DATA.IT_TYPE} = 'S' AND {AC_DATA.SIGN} = '+' THEN {AC_DATA.FINE_WT}"
  },
  {
   "name": "CrTotAmt",
   "ref": "{@CrTotAmt}",
   "type": "NumberField",
   "text": "if {@AcOpAmt} > 0 then {@AcOpAmt} + Sum ({@CrRs}, {AC_DATA.AC_CODE}) else Sum ({@CrRs}, {AC_DATA.AC_CODE})"
  },
  {
   "name": "CurPag",
   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "DrGold",
   "ref": "{@DrGold}",
   "type": "NumberField",
   "text": "if {AC_DATA.IT_TYPE} = 'G' AND {AC_DATA.SIGN} = '-' THEN {AC_DATA.FINE_WT} else 0"
  },
  {
   "name": "DrRs",
   "ref": "{@DrRs}",
   "type": "NumberField",
   "text": "{AC_DATA.DR_AMT}"
  },
  {
   "name": "DrSl",
   "ref": "{@DrSl}",
   "type": "NumberField",
   "text": "if {AC_DATA.IT_TYPE} = 'S' AND {AC_DATA.SIGN} = '-' THEN {AC_DATA.FINE_WT}"
  },
  {
   "name": "DrTotAmt",
   "ref": "{@DrTotAmt}",
   "type": "NumberField",
   "text": "if {@AcOpAmt} < 0 then abs({@AcOpAmt}) + Sum ({@DrRs}, {AC_DATA.AC_CODE}) else Sum ({@DrRs}, {AC_DATA.AC_CODE})"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "StringField",
   "text": ""
  },
  {
   "name": "GoldBalance",
   "ref": "{@GoldBalance}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar GoldBal; GoldBal := GoldBal + {@CrGold} - {@DrGold}; GoldBal;"
  },
  {
   "name": "GoldCrDr",
   "ref": "{@GoldCrDr}",
   "type": "StringField",
   "text": "if {@GoldBalance} < 0 then 'Dr' else 'Cr'"
  },
  {
   "name": "GoldOpBal",
   "ref": "{@GoldOpBal}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar GoldBal := {@AcOpGold} ;"
  },
  {
   "name": "ReSetAcBal",
   "ref": "{@ReSetAcBal}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar GoldBal := 0 ;"
  },
  {
   "name": "ReSetGoldBal",
   "ref": "{@ReSetGoldBal}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar GoldBal := 0 ;"
  },
  {
   "name": "RptTitel",
   "ref": "{@RptTitel}",
   "type": "StringField",
   "text": "\"TRIAL BALANCE AS ON DATE\""
  },
  {
   "name": "RsCrDr",
   "ref": "{@RsCrDr}",
   "type": "StringField",
   "text": "if {@AcBalance} < 0 then 'Dr' else 'Cr'"
  },
  {
   "name": "Silver",
   "ref": "{@Silver}",
   "type": "NumberField",
   "text": "Sum ({@DrSl}, {AC_DATA.AC_CODE}) - Sum ({@CrSl}, {AC_DATA.AC_CODE})"
  },
  {
   "name": "ToDate",
   "ref": "{@ToDate}",
   "type": "StringField",
   "text": ""
  },
  {
   "name": "Weight",
   "ref": "{@Weight}",
   "type": "NumberField",
   "text": ""
  }
