 "formulas": [
  {
   "name": "AcCrAmt",
   "ref": "{@AcCrAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar OpCrAmt; NumberVar OpDrAmt; if OpCrAmt - OpDrAmt > 0 then {@TranCrAmt} + OpCrAmt - OpDrAmt + {@CloseCrAmt} else {@TranCrAmt} + {@CloseCrAmt};"
  },
  {
   "name": "AcDrAmt",
   "ref": "{@AcDrAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar OpCrAmt; NumberVar OpDrAmt; if OpCrAmt - OpDrAmt <= 0 then {@TranDrAmt} + OpDrAmt - OpCrAmt + {@CloseDrAmt} else {@TranDrAmt} + {@CloseDrAmt};"
  },
  {
   "name": "AcPayInt",
   "ref": "{@AcPayInt}",
   "type": "NumberField",
   "text": "12"
  },
  {
   "name": "AcRecInt",
   "ref": "{@AcRecInt}",
   "type": "NumberField",
   "text": "12"
  },
  {
   "name": "BalAmt",
   "ref": "{@BalAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt; BalAmt := BalAmt + {@CrAmt} - {@DrAmt}; BalAmt;"
  },
  {
   "name": "Balance",
   "ref": "{@Balance}",
   "type": "NumberField",
   "text": "EvaluateAfter ({@BalAmt}); WhilePrintingRecords; NumberVar BalAmt;"
  },
  {
   "name": "BalCrDr",
   "ref": "{@BalCrDr}",
   "type": "StringField",
   "text": "EvaluateAfter ({@BalAmt}); WhilePrintingRecords; NumberVar BalAmt; if BalAmt > 0 then 'Cr' else if BalAmt < 0 then 'Dr';"
  },
  {
   "name": "BillNo",
   "ref": "{@BillNo}",
   "type": "StringField",
   "text": "if {AC_DATA.CO_BOOK} >='0010' and {AC_DATA.CO_BOOK} <'0200' then {AC_DATA.CHQ_NO} else {AC_DATA.BILL_NO}"
  },
  {
   "name": "CloseCrAmt",
   "ref": "{@CloseCrAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt ; NumberVar TranCrAmt; NumberVar TranDrAmt; if BalAmt <= 0 then Abs(BalAmt)"
  },
  {
   "name": "CloseDrAmt",
   "ref": "{@CloseDrAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt ; NumberVar TranCrAmt; NumberVar TranDrAmt; if BalAmt > 0 then abs(BalAmt);"
  },
  {
   "name": "Co_Add1",
   "ref": "{@Co_Add1}",
   "type": "StringField",
   "text": "{CO_MAST.CO_ADD1}+' '+{CO_MAST.CO_ADD2}+' '+{CO_MAST.CO_ADD3} + {CO_MAST.CO_CITY}+' '+{CO_MAST.CO_PIN}"
  },
  {
   "name": "Co_Add2",
   "ref": "{@Co_Add2}",
   "type": "UnknownField",
   "text": "{UNIT_NAME.CO_CITY}+' '+{UNIT_NAME.CO_PIN}+' '+'Phone : ' +{UNIT_NAME.CO_PHONE}+' '+' Fax :'+{UNIT_NAME.CO_FAX}"
  },
  {
   "name": "co_name",
   "ref": "{@co_name}",
   "type": "StringField",
   "text": "{CO_MAST.CO_NAME}"
  },
  {
   "name": "CrAmt",
   "ref": "{@CrAmt}",
   "type": "NumberField",
   "text": "if {@FromDate} <= {AC_DATA.VCH_DATE} then if {AC_DATA.SIGN} = '+' then {AC_DATA.FINE_WT} ELSE 0"
  },
  {
   "name": "CurPag",
   "ref": "{@CurPag}",
   "type": "NumberField",
   "text": "PageNumber"
  },
  {
   "name": "days",
   "ref": "{@days}",
   "type": "NumberField",
   "text": "NumberVar Days; Days=0; Days :=({@ToDate}-{AC_DATA.VCH_DATE})+1; Days;"
  },
  {
   "name": "dbcd",
   "ref": "{@dbcd}",
   "type": "StringField",
   "text": "//if isnull({DYBK_MAST.BOOK_SNAME}) or trim({DYBK_MAST.BOOK_SNAME}) = \"\" then {AC_DATA.CO_BOOK} //else // {DYBK_MAST.BOOK_SNAME}"
  },
  {
   "name": "Description",
   "ref": "{@Description}",
   "type": "UnknownField",
   "text": "trim({AC_DATA.DESCR}) //trim({TRAN_DEDC.VCH_DESC})"
  },
  {
   "name": "Divider",
   "ref": "{@Divider}",
   "type": "NumberField",
   "text": "365"
  },
  {
   "name": "DrAmt",
   "ref": "{@DrAmt}",
   "type": "NumberField",
   "text": "if {@FromDate} <= {AC_DATA.VCH_DATE} then if {AC_DATA.SIGN} = '-' then {AC_DATA.FINE_WT} ELSE 0"
  },
  {
   "name": "DueDate",
   "ref": "{@DueDate}",
   "type": "DateField",
   "text": "{AC_DATA.VCH_DATE}"
  },
  {
   "name": "FromDate",
   "ref": "{@FromDate}",
   "type": "DateField",
   "text": "date(2012,04,01)"
  },
  {
   "name": "GroupDate",
   "ref": "{@GroupDate}",
   "type": "DateField",
   "text": "{AC_DATA.VCH_DATE}"
  },
  {
   "name": "HaderPrint",
   "ref": "{@HaderPrint}",
   "type": "BooleanField",
   "text": "WhilePrintingRecords; BooleanVar HeaderPrint:= True;"
  },
  {
   "name": "InitBalAmt",
   "ref": "{@InitBalAmt}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; if OnFirstRecord or {AC_DATA.AC_CODE} <> Previous({AC_DATA.AC_CODE}) then ( NumberVar BalAmt := 0 ; booleanVar OpBalPrint := False; NumberVar TranCrAmt:=0; NumberVar TranDrAmt:=0"
  },
  {
   "name": "interest",
   "ref": "{@interest}",
   "type": "NumberField",
   "text": "if{AC_DATA.SIGN} = '+' and {AC_DATA.FINE_WT} <> 0 then if {@days} = 367 then round((({AC_DATA.FINE_WT} * {@AcPayInt} /100)/{@divider})*({@days}-1),3) else round((({AC_DATA.FINE_WT} * {@AcPayInt} /100)"
  },
  {
   "name": "IntLabel",
   "ref": "{@IntLabel}",
   "type": "StringField",
   "text": "if Sum ({@interest}, {AC_DATA.AC_CODE}) > 0 then \"Net Payable\" else if Sum ({@interest}, {AC_DATA.AC_CODE}) < 0 then \"Net Receivable\""
  },
  {
   "name": "intSumm",
   "ref": "{@intSumm}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar IntTotSum; IntTotSum := IntTotSum +{@interest}; IntTotSum;"
  },
  {
   "name": "LblGrandTotal",
   "ref": "{@LblGrandTotal}",
   "type": "StringField",
   "text": "if Sum ({@interest}) > 0 then \"Net Payable Tota;\" else if Sum ({@interest}) < 0 then \"Net Receivable Total\""
  },
  {
   "name": "MnthCrAmt",
   "ref": "{@MnthCrAmt}",
   "type": "UnknownField",
   "text": "if Sum ({@DrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") - Sum ({@CrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") < 0 then abs(Sum ({@DrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") - Sum ({@CrAmt}, {AC_DATA.VCH_DATE}, \"monthl"
  },
  {
   "name": "MnthDrAmt",
   "ref": "{@MnthDrAmt}",
   "type": "UnknownField",
   "text": "if Sum ({@DrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") - Sum ({@CrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") > 0 then Sum ({@DrAmt}, {AC_DATA.VCH_DATE}, \"monthly\") - Sum ({@CrAmt}, {AC_DATA.VCH_DATE}, \"monthly\")"
  },
  {
   "name": "NetClosing",
   "ref": "{@NetClosing}",
   "type": "NumberField",
   "text": "Sum ({@CrAmt}, {AC_DATA.AC_CODE})+Sum ({@interest}, {AC_DATA.AC_CODE}) -Sum ({@DrAmt}, {AC_DATA.AC_CODE})"
  },
  {
   "name": "NetClosingCrDr",
   "ref": "{@NetClosingCrDr}",
   "type": "StringField",
   "text": "if {@NetClosing}> 0 then 'Cr' else if {@NetClosing}< 0 then 'Dr'"
  },
  {
   "name": "NextDate",
   "ref": "{@NextDate}",
   "type": "DateField",
   "text": "WhilePrintingRecords; dateVar NextDate; if {@GroupDate} >= {@FromDate} then if OnLastRecord or {AC_DATA.AC_CODE} <> Next({AC_DATA.AC_CODE}) then NextDate := {@ToDate} else NextDate := Next({@GroupDate"
  },
  {
   "name": "OnlyOpIntr",
   "ref": "{@OnlyOpIntr}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar TranDrAmt; NumberVar TranCrAmt; NumberVar OpDrAmt; NumberVar OpCrAmt; NumberVar TotIntAmt; if not (TranDrAmt <> 0 Or TranCrAmt <> 0 or (OpCrAmt - OpDrAmt) = 0) then Tot"
  },
  {
   "name": "OpBal",
   "ref": "{@OpBal}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt; abs(BalAmt);"
  },
  {
   "name": "OpBalCrDr",
   "ref": "{@OpBalCrDr}",
   "type": "StringField",
   "text": "WhilePrintingRecords; NumberVar BalAmt; if BalAmt > 0 then 'Cr' else if BalAmt < 0 then 'Dr';"
  },
  {
   "name": "OpBalPrint",
   "ref": "{@OpBalPrint}",
   "type": "BooleanField",
   "text": "WhilePrintingRecords; booleanVar OpBalPrint; if {AC_DATA.VCH_DATE} >= {@FromDate} then OpBalPrint := True;"
  },
  {
   "name": "OpCredit",
   "ref": "{@OpCredit}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt; if BalAmt > 0 then BalAmt else 0;"
  },
  {
   "name": "OpDays",
   "ref": "{@OpDays}",
   "type": "NumberField",
   "text": "NumberVar Days; Days := {@ToDate} -{AC_DATA.VCH_DATE}; Days;"
  },
  {
   "name": "OpDebit",
   "ref": "{@OpDebit}",
   "type": "NumberField",
   "text": "WhilePrintingRecords; NumberVar BalAmt; if BalAmt < 0 then BalAmt else 0;"
  },
  {
   "name": "OpInterest",
   "ref": "{@OpInterest}",
   "type": "NumberField",
   "text": "whileprintingrecords; if {@Opproduct} < 0 then {@Opproduct} * {@pay_int}/({@divider}*100) else {@Opproduct} * {@rec_int}/({@divider}*100)"
  },
  {
   "name": "OpProduct",
   "ref": "{@OpProduct}",
   "type": "NumberField",
   "text": "whileprintingrecords; NumberVar BalAmt; NumberVar Days; BalAmt * Days * -1;"
  },
  {
   "name": "Pay_Int",
   "ref": "{@Pay_Int}",
   "type": "NumberField",
   "text": "{@AcPayInt}"
  },
  {
   "name": "product",
   "ref": "{@product}",
   "type": "NumberField",
   "text": "EvaluateAfter ({@Balance}); whileprintingrecords; NumberVar Product; NumberVar BalAmt; NumberVar Days; Product := BalAmt * {@Days} * -1; Product;"
  },
  {
   "name": "Rec_Int",
   "ref": "{@Rec_Int}",
   "type": "NumberField",
   "text": "{@AcRecInt}"
  },
