# DataCareNext — environment template. Copy to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real secrets. docker-compose.yml reads this file.

# =============================================================================
# Database
# =============================================================================
# Compose passwords (Postgres superuser + the app_user role used at runtime).
POSTGRES_PASSWORD=change-me-postgres-superuser
APP_DB_PASSWORD=change-me-app-user

# Runtime connection used by the API. MUST be the NON-superuser app_user so that
# Row-Level Security is enforced (created by packages/db/setup_roles.sql).
# Host is the compose service name `postgres`; keep ?schema=public.
DATABASE_URL=postgresql://app_user:change-me-app-user@postgres:5432/datacare?schema=public

# Owner/superuser connection used ONLY for DDL: `prisma migrate deploy`, rls.sql,
# setup_roles.sql (see DEPLOY.md). Not injected into the long-running API service.
MIGRATE_DATABASE_URL=postgresql://datacare:change-me-postgres-superuser@postgres:5432/datacare?schema=public

# =============================================================================
# Auth
# =============================================================================
# Injected into buildApp({ secret }). Use a long random string, e.g.:
#   openssl rand -hex 48
JWT_SECRET=change-me-long-random-string

# =============================================================================
# Web -> API proxy
# =============================================================================
# next.config.mjs proxies /api/:path* -> ${API_ORIGIN}/:path*. This value is
# BAKED AT BUILD TIME into the web image (docker-compose passes it as a build arg).
# Inside compose the API is reachable at http://api:4000.
API_ORIGIN=http://api:4000

# =============================================================================
# App
# =============================================================================
NODE_ENV=production
APP_VERSION=0.0.0
# Tenant served by this API deployment. Must match the tenant_id used by migration/ETL.
APP_TENANT_ID=default
# Separate development-only demo seed target.
DEMO_TENANT=default
# Demo seed runs only when NODE_ENV!=production; keep 0 to disable explicitly.
SEED_DEMO=0

# =============================================================================
# Integrations — leave BLANK to use the built-in Fake/no-op senders.
# Each feature is fully wired; it goes live the moment its credentials are set,
# with no code change. Variable names match what the API actually reads.
# =============================================================================

# --- e-Invoice / GST (Chartered Info GSP). All five required to enable; ---------
# --- otherwise the Fake IRN transport is used. -------------------------------
GSP_ASPID=
GSP_PASSWORD=
GSP_GSTIN=
GSP_USER=
GSP_EINV_PWD=
# Sandbox by default; set to 0 for the production GSP host.
GSP_SANDBOX=1

# --- WhatsApp Cloud API (Meta Graph). Both required to enable. ----------------
WA_PHONE_ID=
WA_TOKEN=
# Optional Graph API version override (e.g. v22.0); defaults in code if unset.
WA_API_VERSION=

# --- SMS gateway (generic HTTP). URL template + key required to enable. -------
# SMS_URL_TEMPLATE is the provider's HTTP endpoint with placeholders.
SMS_URL_TEMPLATE=
SMS_KEY=
# Sender/header id shown to recipients (defaults to JEWELL if unset).
SMS_SENDER=

# =============================================================================
# Backups (consumed by deploy/backup.sh)
# =============================================================================
# BACKUP_DIR=/var/backups/datacare
# RETENTION_DAYS=14
